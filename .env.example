# .env.example — SAFE TO COMMIT. Placeholders only; never put real keys here.
# Copy this file to .env.local (or .env) and replace the placeholders with values
# from Supabase → Project Settings → API Keys. NEVER commit the real .env / .env.local.
#
# Security contract: docs/sponsor-auth-requirements.md (section 7)
# Per-variable rules:  docs/env-var-checklist.md
# Setup steps:         docs/setup/supabase-env-checklist.md

# ---- Client-safe (may be used in browser code; data still protected by RLS) ----
# VITE_ prefix = Vite copies the value into the browser bundle, so ONLY public
# values may use it. (vite.config.ts sets no custom envPrefix, so VITE_ is the default.)

# Public Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon / publishable key (safe in the browser ONLY because RLS policies protect data)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Server-only (MUST NOT be imported into client/browser bundles) ----
# Service role key BYPASSES Row Level Security. Read it only in trusted server
# code (src/lib/supabase/server.ts). Never add a VITE_ prefix to it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Same project URL without a VITE_ prefix, for server-side reads
SUPABASE_URL=https://your-project-ref.supabase.co
