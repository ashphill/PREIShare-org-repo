# .env.example — commit this file. Never put real keys here.
# Copy to .env.local (or .env) for local development and fill in values
# from Supabase → Project Settings → API.
#
# Source of truth: docs/requirements/sponsor-auth-and-listings-brief.md
# (see "Server-only boundary"). Setup steps: docs/setup/supabase-env-checklist.md

# ---------------------------------------------------------------------------
# PUBLIC / BROWSER-SAFE (may be exposed to the client bundle)
# This project uses Vite's default public prefix: VITE_
# (vite.config.ts sets no custom envPrefix). Anything starting with VITE_
# is copied into the browser bundle, so only browser-safe values go here.
# These values are NOT secret when Row Level Security (RLS) is enabled.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS (never add the VITE_ prefix; never import in browser code)
# The service role key bypasses Row Level Security. Read it only in
# TanStack Start server functions / route loaders. It must never ship
# in the client bundle.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same project URL without the public prefix, for server code that reads
# non-VITE_ variables.
SUPABASE_URL=https://your-project-ref.supabase.co
